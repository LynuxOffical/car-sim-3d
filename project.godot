[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="peds"
3d_physics/layer_5="props"

[physics]
3d/default_gravity=12.0
common/physics_interpolation=false

[rendering]
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.08, 0.1, 0.14, 1)
textures/vram_compression/import_etc2_astc=true
